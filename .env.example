# ==============================================================================
# SENTINEL AI - ENVIRONMENT CONFIGURATION
# "Autonomy with a Boundary" - Automate India Grand Finale
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ArmorIQ Configuration
# Provide your ArmorIQ API key to route through live cloud proxy.
# If omitted or set to 'mock', Sentinel AI runs its embedded cryptographic verification engine.
ARMORIQ_API_KEY=ak_armoriq_test_key_live_2026
ARMORIQ_USER_ID=sentinel-admin@sentinel-ai.internal
ARMORIQ_AGENT_ID=agent-refund-ops-01
ARMORIQ_PROXY_URL=https://api.armoriq.ai

# AI Model Provider Configuration
# Supported providers: gemini | openai | anthropic | deterministic
AI_PROVIDER=deterministic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gemini-2.5-flash

# Financial Authorization Policies
MAX_AUTONOMOUS_REFUND_LIMIT=5000
CURRENCY=INR

# Database Configuration
DATABASE_PATH=./sentinel.db
